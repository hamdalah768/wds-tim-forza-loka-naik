# Isi APP_ORIGIN persis sama dengan alamat di browser. Rahasia hanya di server.
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# GOOGLE: keduanya harus diisi bersama. Callback /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FACEBOOK: versi Graph API dari dasbor aplikasi Anda. Callback /api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
# Nomor HP: gunakan Twilio Verify Service. Pengiriman SMS mengikuti tarif provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Opsional: direktori privat, jangan menunjuk ke folder public.
# DATABASE_PATH=/var/lib/lokanaik/lokanaik.sqlite
